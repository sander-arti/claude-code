# Research Agent Environment Configuration
# Copy this file to .env and fill in your actual API keys

# ==========================================
# REQUIRED API KEYS
# ==========================================

# Brave Search API Key (Required)
# Get your API key from: https://brave.com/search/api/
# Note: Credit card required even for free tier (anti-fraud measure)
BRAVE_API_KEY=your_brave_api_key_here

# OpenAI API Key (Required if using OpenAI models)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# MODEL CONFIGURATION
# ==========================================

# Model provider: openai, anthropic, etc.
MODEL_PROVIDER=openai

# Specific model name to use
MODEL_NAME=gpt-4

# ==========================================
# SEARCH CONFIGURATION
# ==========================================

# Maximum number of search results to fetch (1-20)
MAX_SEARCH_RESULTS=10

# Search language (ISO 639-1 code)
SEARCH_LANGUAGE=en

# Search country (ISO 3166-1 alpha-2 code)
SEARCH_COUNTRY=us

# ==========================================
# AGENT CONFIGURATION
# ==========================================

# Maximum retry attempts for failed requests
MAX_RETRIES=3

# Timeout for API requests in seconds
TIMEOUT_SECONDS=30

# Enable debug logging (true/false)
DEBUG=false

# ==========================================
# USAGE NOTES
# ==========================================

# 1. BRAVE API LIMITATIONS:
#    - Free tier: 1 query/second, 2,000 queries/month
#    - Base AI: Up to 20 queries/second, 20M queries/month
#    - Pro AI: Up to 50 queries/second, unlimited queries
#
# 2. SECURITY:
#    - Never commit your .env file to version control
#    - Keep your API keys secure and rotate them regularly
#    - Use different API keys for development and production
#
# 3. RATE LIMITING:
#    - The agent respects API rate limits automatically
#    - Adjust MAX_SEARCH_RESULTS based on your API tier
#    - Monitor your usage to avoid exceeding quotas
#
# 4. MODEL SELECTION:
#    - OpenAI models: gpt-4, gpt-3.5-turbo, etc.
#    - Anthropic models: claude-3-opus, claude-3-sonnet, etc.
#    - Make sure you have access to the specified model